#!/bin/sh
# ComboShip AppImage entry point.
#
# The launcher's runtime layout is portable: it dlopens ./libsoh.so, ./lib2ship.so and
# ./comboui.so relative to the CURRENT DIRECTORY, and looks for the game archives
# (soh.o2r / 2ship.o2r bundled here; oot.o2r / mm.o2r extracted from the player's ROMs),
# saves and config there too (see combo/ComboShip.cpp LoadDll). The AppImage mount is
# read-only, so this script anchors a writable data directory, exposes the bundled
# runtime pieces inside it, and runs the launcher from there.
#
# Data directory, in order of preference:
#   $SHIP_HOME                        — explicit override (also honored by libultraship)
#   <dir with the AppImage>/ComboShip-data — portable default
#   $PWD                              — fallback when run from an extracted AppDir
set -u

HERE="$(dirname "$(readlink -f "$0")")"
BIN="$HERE/usr/bin"

if [ -n "${SHIP_HOME:-}" ]; then
    DATA="$SHIP_HOME"
elif [ -n "${APPIMAGE:-}" ]; then
    DATA="$(dirname "$APPIMAGE")/ComboShip-data"
else
    DATA="$PWD"
fi
mkdir -p "$DATA" || exit 1

# One running instance per data directory (full-coop-sync: local two-client co-op testing). Two copies
# sharing one directory share comboship.json — so the same Anchor client id, which the relay treats as a
# reconnect and kicks the first — and the same save files. A second copy opened while the first holds the
# lock runs from "<data>-2" (then -3, ...): its own config and saves, the ROM archives reused from the
# primary directory, and COMBO_INSTANCE set so the launcher asks the relay for a fresh client id.
# The lock is fd 9, inherited by the launcher through exec and released when it exits.
BASE="$DATA"
INSTANCE=1

# PIDs (other than us) holding "$1/.instance.lock" open.
lock_holders() {
    for fd in /proc/[0-9]*/fd/*; do
        if [ "$(readlink "$fd" 2>/dev/null)" = "$1/.instance.lock" ]; then
            pid="${fd#/proc/}"
            pid="${pid%%/*}"
            [ "$pid" != "$$" ] && echo "$pid"
        fi
    done 2>/dev/null | sort -u | tr '\n' ' '
}

# The main folder is locked: a copy is running, or a crashed copy never exited and still holds it (that silently sent
# every launch, old AppImages too, to an empty ComboShip-data-N -- owner 2026-11-14: "my saves have all dissapeared").
# Say so and let the player close it instead of quietly running without their saves. Returns 0 = take the folder back.
ask_take_over() {
    holders="$(lock_holders "$1")"
    msg="Your WomboComboShip data folder (with your saves) is in use by another copy that is still running (PID ${holders:-unknown}).

If you can't see another WomboComboShip window, it is a copy that crashed or froze and never closed.

Close it and continue with your saves?
(No = run this copy separately, with its own empty saves, for local co-op.)"
    echo "ComboShip: $1 is locked by PID(s) ${holders:-unknown}" >&2
    if command -v kdialog >/dev/null 2>&1; then
        kdialog --title "WomboComboShip" --warningyesno "$msg" --yes-label "Close it, use my saves" \
            --no-label "Run separately" || return 1
    elif command -v zenity >/dev/null 2>&1; then
        zenity --question --title="WomboComboShip" --text="$msg" --ok-label="Close it, use my saves" \
            --cancel-label="Run separately" --width=480 2>/dev/null || return 1
    else
        return 1
    fi
    [ -n "$holders" ] && kill -9 $holders 2>/dev/null
    return 0
}

if command -v flock >/dev/null 2>&1; then
    while :; do
        exec 9>"$DATA/.instance.lock"
        if flock -n 9; then
            break
        fi
        if [ "$INSTANCE" -eq 1 ] && [ -z "${COMBO_NO_TAKEOVER:-}" ] && ask_take_over "$DATA" &&
            flock -w 5 9; then
            break
        fi
        exec 9>&-
        INSTANCE=$((INSTANCE + 1))
        DATA="$BASE-$INSTANCE"
        mkdir -p "$DATA" || exit 1
    done
fi
if [ "$INSTANCE" -gt 1 ]; then
    for f in oot.o2r oot-mq.o2r mm.o2r; do
        if [ -e "$BASE/$f" ] && [ ! -e "$DATA/$f" ]; then
            ln -s "$BASE/$f" "$DATA/$f"
        fi
    done
    # First run of this instance: start from the primary's settings (name, Anchor host/room, controls).
    if [ -f "$BASE/comboship.json" ] && [ ! -e "$DATA/comboship.json" ]; then
        cp "$BASE/comboship.json" "$DATA/comboship.json"
    fi
    export COMBO_INSTANCE="$INSTANCE"
fi
export SHIP_HOME="$DATA"

# Read-only bundled pieces, exposed via symlinks refreshed every run (the mount point
# changes between runs). A real file/dir with the same name is a user override — keep it.
for f in libsoh.so lib2ship.so libultraship.so comboui.so soh.o2r 2ship.o2r assets; do
    if [ -e "$BIN/$f" ] && { [ -L "$DATA/$f" ] || [ ! -e "$DATA/$f" ]; }; then
        ln -sfn "$BIN/$f" "$DATA/$f"
    fi
done

# Writable content that ships with defaults: copied once, then owned by the user.
for d in mods presets randomizer; do
    if [ -d "$BIN/$d" ] && [ ! -e "$DATA/$d" ]; then
        cp -r "$BIN/$d" "$DATA/$d"
    fi
done

# Bundled deps live in usr/lib (and libultraship.so in usr/bin). The built libraries
# carry no usable RUNPATH outside the build tree, so resolve everything explicitly.
# The launcher restores the host's value (saved below) at startup so child processes
# (zenity, kdialog) don't load the bundle's libraries.
export COMBO_HOST_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="$BIN:$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

cd "$DATA" || exit 1
exec "$BIN/ComboShip" "$@"
